# App
NEXT_PUBLIC_APP_URL=https://konfeti.belgacai.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo
BREVO_API_KEY=
EMAIL_FROM=Konfeti <konfeti@belgacai.com>

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google
GOOGLE_MAPS_API_KEY=

# Awin (affiliation TheFork, brief 4.6 V1.1) : IDs fournis une fois le compte
# Awin créé et accepté dans le programme TheFork -- voir DECISIONS.md pour la
# procédure. Sans ces variables, le lien resto pointe directement vers
# TheFork sans tracking (comportement dégradé mais jamais bloquant).
AWIN_MERCHANT_ID=
AWIN_AFFILIATE_ID=

# Cron (protection des routes cron Vercel)
CRON_SECRET=

# Notifications push (Web Push, générées une fois via `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:konfeti@belgacai.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
# Optionnelles : uniquement pour l'upload des source maps au build (pas bloquant sans elles)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Back-office /admin (voir doc/PROGRESS.md pour comment générer ces valeurs)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Coupe-circuit du rate limiting (createEvent/submitRsvp/etc, voir
# src/lib/rate-limit.ts) -- "true" pour désactiver, utile en dev/tests e2e
# répétés. Ne JAMAIS mettre "true" en production. Laisser vide/absent = activé.
RATE_LIMIT_DISABLED=

# Lien Play Store sur la landing (src/app/[locale]/page.tsx) -- "true"
# seulement une fois la fiche réellement publiée sur le Play Store, sinon le
# lien affiché serait cassé (404). Laisser vide/absent = "Bientôt disponible".
PLAY_STORE_PUBLISHED=
